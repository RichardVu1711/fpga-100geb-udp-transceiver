# ======== Generate Bitstream Script ========
# This script is used to generate the bitstream
# for the project that generated by the Vivado

set origin_dir "."
set src_dir "."
set isForce 0
set _xil_proj_name_ "project_1"

if { $::argc > 0 } {
  for {set i 0} {$i < $::argc} {incr i} {
    set option [string trim [lindex $::argv $i]]
    switch -regexp -- $option {
      "--origin_dir"   { incr i; set origin_dir [lindex $::argv $i] }
      "--project_name" { incr i; set _xil_proj_name_ [lindex $::argv $i] }
      "--force"        { incr i; set isForce [lindex $::argv $i] }
      default {
        if { [regexp {^-} $option] } {
          puts "ERROR: Unknown option '$option' specified.\n"
          return 1
        }
      }
    }
  }
}

# ------------------------------------------------------------------------
# 1. Open the Existing Project
# ------------------------------------------------------------------------
set project_dir $origin_dir/$_xil_proj_name_
set project_xpr $project_dir/$_xil_proj_name_.xpr

if { ![file exists $project_xpr] } {
  error "ERROR: The target project '$_xil_proj_name_' does not exist at '$project_xpr'."
  return 1
} elseif { ![file exists $origin_dir/rf_4x2.xdc] } {
  error "ERROR: Constraint file does not exist in the origin directory"
  return 1
}

open_project $project_xpr

# ------------------------------------------------------------------------
# 2. Reset Previous Runs (only when forced -- otherwise let Vivado skip
#    runs that are already up-to-date)
# ------------------------------------------------------------------------
if { $isForce } {
  reset_run synth_1
  reset_run impl_1
}

# ------------------------------------------------------------------------
# 3. Compile and generate bitstream
# ------------------------------------------------------------------------
# run synthesis (a run that has never been launched must be reset first;
# retry once with reset_run if Vivado complains about that)
if { [catch {launch_runs synth_1 -jobs 16}] } {
  reset_run synth_1
  launch_runs synth_1 -jobs 16
}
wait_on_run synth_1
if { [get_property PROGRESS [get_runs synth_1]] != "100%" } {
  error "Error: Synthesis failed"
}

# run implementation + bitstream
if { [catch {launch_runs impl_1 -to_step write_bitstream -jobs 16}] } {
  reset_run impl_1
  launch_runs impl_1 -to_step write_bitstream -jobs 16
}
wait_on_run impl_1
if { [get_property PROGRESS [get_runs impl_1]] != "100%" } {
  error "Error: Implementation failed"
}

# ------------------------------------------------------------------------
# 4. Export hardware platform (.xsa, includes the .hwh) for PYNQ
# ------------------------------------------------------------------------
open_run impl_1
set xsa_path "$project_dir/${_xil_proj_name_}.xsa"
write_hw_platform -fixed -include_bit -force -file $xsa_path
puts "Hardware platform written to: $xsa_path"

# ------------------------------------------------------------------------
# 5. Wrap up projects
# ------------------------------------------------------------------------
puts "========================================================"
puts " Build Completed Successfully! Bitstream + XSA generated. "
puts "========================================================"

close_project
exit
