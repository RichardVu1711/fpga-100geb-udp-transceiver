# ==== BD design_1 ====
proc cr_bd_design_1 { parentCell } {

  # CHANGE DESIGN NAME HERE
  set design_name design_1

  common::send_gid_msg -ssname BD::TCL -id 2010 -severity "INFO" "Currently there is no design <$design_name> in project, so creating one..."

  create_bd_design $design_name

  set bCheckIPsPassed 1
  ##################################################################
  # CHECK IPs
  ##################################################################
  set bCheckIPs 1

  if { $bCheckIPs == 1 } {
    set list_check_ips "\ 
  xilinx.com:ip:xlconstant:1.1\
  xilinx.com:ip:clk_wiz:6.0\
  xilinx.com:ip:axis_clock_converter:1.1\
  xilinx.com:ip:zynq_ultra_ps_e:3.5\
  xilinx.com:ip:cmac_usplus:3.1\
  xilinx.com:ip:axi_dma:7.1\
  xilinx.com:ip:smartconnect:1.0\
  xilinx.com:ip:system_ila:1.1\
  xilinx.com:ip:proc_sys_reset:5.0\
  xilinx.com:ip:axis_dwidth_converter:1.1\
  xilinx.com:ip:xlconcat:2.1\
  "

    set list_ips_missing ""
    common::send_gid_msg -ssname BD::TCL -id 2011 -severity "INFO" "Checking if the following IPs exist in the project's IP catalog: $list_check_ips ."

    foreach ip_vlnv $list_check_ips {
      set ip_obj [get_ipdefs -all $ip_vlnv]
      if { $ip_obj eq "" } {
          lappend list_ips_missing $ip_vlnv
      }
    }
  }
  
  if { $list_ips_missing ne "" } {
    catch {common::send_gid_msg -ssname BD::TCL -id 2012 -severity "ERROR" "The following IPs are not found in the IP Catalog:\n  $list_ips_missing\n\nResolution: Please add the repository containing the IP(s) to the project." }
    set bCheckIPsPassed 0
  }

  if { $bCheckIPsPassed != 1 } {
    common::send_gid_msg -ssname BD::TCL -id 2023 -severity "WARNING" "Will not continue with creation of design due to the error(s) above."
    return 3
  }

  if { $parentCell eq "" } {
     set parentCell [get_bd_cells /]
  }

  # Get object for parentCell
  set parentObj [get_bd_cells $parentCell]
  if { $parentObj == "" } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2090 -severity "ERROR" "Unable to find parent cell <$parentCell>!"}
     return
  }
  # ==== CONSTANT PARAMETERS ====
  set OP_CLK_FREQ 300000000
  set SYS_CLK_FREQ 100000000
  set RX_CLK_FREQ 322000000
  set TX_CLK_FREQ 322000000


  # Make sure parentObj is hier blk
  set parentType [get_property TYPE $parentObj]
  if { $parentType ne "hier" } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2091 -severity "ERROR" "Parent <$parentObj> has TYPE = <$parentType>. Expected to be <hier>."}
     return
  }

  # Save current instance; Restore later
  set oldCurInst [current_bd_instance .]

  # Set parent object as current
  current_bd_instance $parentObj
  # ==== Set list of clks and resets =====
  set sysclk_100_lst  [list]
  set arst_100_lst    [list]
  set opclk_300_lst   [list]
  set arst_300_lst    [list]
  # -- $cmac/gt_rxusrclk2 and gt_txusrclk2
  set rxclk_322_lst   [list] 
  set arst_322_lst    [list]
  set txclk_322_lst   [list]
  set arst_tx322_lst  [list]
  # -- $debugger
  set axi_ila_lst     [list]


  # ==== PORTS / INTERFACE ====
  set gt_rtl [ create_bd_intf_port -mode Master -vlnv xilinx.com:interface:gt_rtl:1.0 gt_rtl ]

  set gt_ref_clk [ create_bd_intf_port -mode Slave -vlnv xilinx.com:interface:diff_clock_rtl:1.0 gt_ref_clk ]
  set_property -dict [ list \
    CONFIG.FREQ_HZ {156250000} \
  ] $gt_ref_clk

  set qsfp_lpmode [ create_bd_port -dir O -from 0 -to 0 qsfp_lpmode ]
  set qsfp_resetl [ create_bd_port -dir O -from 0 -to 0 qsfp_resetl ]
  set qsfp_modsell [ create_bd_port -dir O -from 0 -to 0 qsfp_modsell ]

  # Create constants
  set xlconstant_0 [ create_bd_cell -type ip -vlnv xilinx.com:ip:xlconstant:1.1 xlconstant_0 ]
  set_property CONFIG.CONST_VAL {0} $xlconstant_0
  set xlconstant_1 [ create_bd_cell -type ip -vlnv xilinx.com:ip:xlconstant:1.1 xlconstant_1 ]
  set_property CONFIG.CONST_VAL {1} $xlconstant_1
  # connect qsfp_modsell and qsfp_resetl to constant 1
  connect_bd_net [get_bd_pins xlconstant_1/dout] \
                  [get_bd_pins qsfp_modsell]\
                  [get_bd_pins qsfp_resetl]

  # Instance: ps_axi_periph, and set properties
  set ps_axi_periph [ create_bd_cell -type ip -vlnv xilinx.com:ip:smartconnect:1.0 ps_axi_periph ]
  set_property -dict [list \
    CONFIG.NUM_CLKS {1} \
    CONFIG.NUM_MI {4} \
    CONFIG.NUM_SI {2} \
  ] $ps_axi_periph

  lappend sysclk_100_lst [get_bd_pins $ps_axi_periph/aclk]
  lappend arst_100_lst   [get_bd_pins $ps_axi_periph/aresetn]


  # ==== CLOCKING ====
  set clk_wiz_0 [ create_bd_cell -type ip -vlnv xilinx.com:ip:clk_wiz:6.0 clk_wiz_0 ]
  set_property -dict [list \
    CONFIG.CLKOUT2_JITTER {102.086} \
    CONFIG.CLKOUT2_PHASE_ERROR {87.180} \
    CONFIG.CLKOUT2_REQUESTED_OUT_FREQ {200.000} \
    CONFIG.CLKOUT2_USED {true} \
    CONFIG.CLKOUT3_JITTER {94.862} \
    CONFIG.CLKOUT3_PHASE_ERROR {87.180} \
    CONFIG.CLKOUT3_REQUESTED_OUT_FREQ {300.000} \
    CONFIG.CLKOUT3_USED {true} \
    CONFIG.CLKOUT4_JITTER {90.074} \
    CONFIG.CLKOUT4_PHASE_ERROR {87.180} \
    CONFIG.CLKOUT4_REQUESTED_OUT_FREQ {400.000} \
    CONFIG.CLKOUT4_USED {true} \
    CONFIG.CLK_OUT1_PORT {sysclk} \
    CONFIG.CLK_OUT2_PORT {clk_out2} \
    CONFIG.CLK_OUT3_PORT {opclk} \
    CONFIG.MMCM_CLKOUT1_DIVIDE {6} \
    CONFIG.MMCM_CLKOUT2_DIVIDE {4} \
    CONFIG.MMCM_CLKOUT3_DIVIDE {3} \
    CONFIG.NUM_OUT_CLKS {4} \
    CONFIG.RESET_BOARD_INTERFACE {Custom} \
    CONFIG.RESET_PORT {resetn} \
    CONFIG.RESET_TYPE {ACTIVE_LOW} \
    CONFIG.USE_BOARD_FLOW {true} \
  ] $clk_wiz_0
  
  # ==== Convert 322 MHz CMAC RX Stream ====
  # .... convert the 322 MHz CMAC RX stream to 300 MHz for DMA
  set axis_clk_converter_rx [ create_bd_cell -type ip -vlnv xilinx.com:ip:axis_clock_converter:1.1 axis_clk_converter_rx ]
  # .... convert the 300 MHz DMA stream to 322 MHz for CMAC TX stream
  set axis_clk_converter_tx [ create_bd_cell -type ip -vlnv xilinx.com:ip:axis_clock_converter:1.1 axis_clk_converter_tx ]

  # .... convert DMA (300) in Master to CMAC RX (322) in Slave
  lappend rxclk_322_lst  [get_bd_pins $axis_clk_converter_rx/s_axis_aclk]
  lappend arst_322_lst   [get_bd_pins $axis_clk_converter_rx/s_axis_aresetn]
  lappend arst_300_lst   [get_bd_pins $axis_clk_converter_rx/m_axis_aresetn]
  lappend opclk_300_lst  [get_bd_pins $axis_clk_converter_rx/m_axis_aclk]
  # .... convert DMA (300) in Slave to CMAC TX (322) in Master
  lappend txclk_322_lst  [get_bd_pins $axis_clk_converter_tx/m_axis_aclk]
  lappend arst_tx322_lst [get_bd_pins $axis_clk_converter_tx/m_axis_aresetn]
  lappend opclk_300_lst  [get_bd_pins $axis_clk_converter_tx/s_axis_aclk]
  lappend arst_300_lst   [get_bd_pins $axis_clk_converter_tx/s_axis_aresetn]

  # ==== RX burst buffer ====
  # .... axis_clk_converter_rx's own FIFO is small/fixed (CDC only, not burst capacity) and
  #      cmac/axis_rx cannot be backpressured — absorb back-to-back packet bursts in the
  #      322 MHz CMAC RX domain, before the converter's own FIFO can overflow
  set axis_data_fifo_rx [ create_bd_cell -type ip -vlnv xilinx.com:ip:axis_data_fifo:2.0 axis_data_fifo_rx ]
  set_property -dict [list \
    CONFIG.FIFO_DEPTH {512} \
    CONFIG.IS_ACLK_ASYNC {1} \
  ] $axis_data_fifo_rx
  lappend rxclk_322_lst  [get_bd_pins $axis_data_fifo_rx/s_axis_aclk]
  lappend arst_322_lst   [get_bd_pins $axis_data_fifo_rx/s_axis_aresetn]
  lappend rxclk_322_lst  [get_bd_pins $axis_data_fifo_rx/m_axis_aclk]

  # ==== ZYNQ MPSoC ====
  set zynqmp_ps [zynq_mp_crt]
  #... connect sysclk to saxi and maxi aclk
  lappend sysclk_100_lst {*}[get_bd_pins $zynqmp_ps/saxihpc*_fpd_aclk]
  lappend sysclk_100_lst {*}[get_bd_pins $zynqmp_ps/maxihpm*_fpd_aclk]
  # ... connect pl_resetn0 and pl_clk0 to clk_wiz_0
  connect_bd_net [get_bd_pins $zynqmp_ps/pl_clk0] [get_bd_pins $clk_wiz_0/clk_in1]
  connect_bd_net [get_bd_pins $zynqmp_ps/pl_resetn0] [get_bd_pins $clk_wiz_0/resetn]

  # ==== CMAC / ETHERNET ====
  set cmac [ create_bd_cell -type ip -vlnv xilinx.com:ip:cmac_usplus:3.1 cmac ]
  set_property -dict [list \
    CONFIG.CMAC_CAUI4_MODE {1} \
    CONFIG.ENABLE_AXI_INTERFACE {1} \
    CONFIG.GT_LOCATION {1} \
    CONFIG.GT_REF_CLK_FREQ {156.25} \
    CONFIG.USER_INTERFACE {AXIS} \
    CONFIG.INCLUDE_RS_FEC {1} \
    CONFIG.RX_FLOW_CONTROL {0} \
    CONFIG.TX_FLOW_CONTROL {0} \
  ] $cmac
  # .... mapping unnessary signals to constant0
  connect_bd_net [get_bd_pins xlconstant_0/dout] \
                [get_bd_pins qsfp_lpmode] \
                [get_bd_pins $cmac/gtwiz_reset_tx_datapath] \
                [get_bd_pins $cmac/gtwiz_reset_rx_datapath] \
                [get_bd_pins $cmac/pm_tick] \
                [get_bd_pins $cmac/core_rx_reset] \
                [get_bd_pins $cmac/core_tx_reset] \
                [get_bd_pins $cmac/core_drp_reset]
  # .... connect cmac gt_serial_port to IO port: gt_rtl
  connect_bd_intf_net [get_bd_intf_ports $gt_rtl] [get_bd_intf_pins $cmac/gt_serial_port]
  #.... connect cmac ref clock to its output pins
  connect_bd_intf_net [get_bd_intf_ports gt_ref_clk] [get_bd_intf_pins $cmac/gt_ref_clk]

  lappend sysclk_100_lst [get_bd_pins $cmac/s_axi_aclk]
  lappend sysclk_100_lst [get_bd_pins $cmac/drp_clk]
  lappend sysclk_100_lst [get_bd_pins $cmac/init_clk]
  lappend rxclk_322_lst [get_bd_pins $cmac/rx_clk]
  # .... s_axi_sreset and sys_reset connected to peripheral_reset
  

  # ==== AXI DMA ====
  set dma [ create_bd_cell -type ip -vlnv xilinx.com:ip:axi_dma:7.1 dma ]
  set_property -dict [list \
    CONFIG.c_sg_length_width {16} \
    CONFIG.c_include_sg {0} \
  ] $dma
  lappend opclk_300_lst    {*}[get_bd_pins $dma/m_axi_*_aclk]
  lappend sysclk_100_lst   [get_bd_pins $dma/s_axi_lite_aclk]
  lappend arst_100_lst     [get_bd_pins $dma/axi_resetn]

  # ==== SmartConnect ====
  set axi_smc [ create_bd_cell -type ip -vlnv xilinx.com:ip:smartconnect:1.0 axi_smc ]
  set_property -dict [list \
    CONFIG.NUM_CLKS {2} \
    CONFIG.NUM_MI {2} \
    CONFIG.NUM_SI {2} \
  ] $axi_smc
  lappend arst_100_lst   [get_bd_pins $axi_smc/aresetn]
  lappend sysclk_100_lst [get_bd_pins $axi_smc/aclk]
  lappend opclk_300_lst  [get_bd_pins $axi_smc/aclk1]

  # ==== Concat ====
  set concat0 [ create_bd_cell -type ip -vlnv xilinx.com:ip:xlconcat:2.1 xlconcat_0 ]
  set_property -dict [list \
    CONFIG.IN0_WIDTH {2} \
    CONFIG.IN1_WIDTH {8} \
    CONFIG.NUM_PORTS {2} \
  ] $concat0

  # ==== RXTop Wrapper ====
  set block_name RXTop_wrapper
  set block_cell_name RXTop_inst
  if { [catch {set RXTop_inst [create_bd_cell -type module -reference $block_name $block_cell_name] } errmsg] } {
    catch {common::send_gid_msg -ssname BD::TCL -id 2095 -severity "ERROR" "Unable to add referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
    return 1
  } elseif { $RXTop_inst eq "" } {
    catch {common::send_gid_msg -ssname BD::TCL -id 2096 -severity "ERROR" "Unable to referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
    return 1
  }
  set axsio_names {m00_axis s00_axis marp_axis}
  set_property CONFIG.ASSOCIATED_BUSIF [join $axsio_names ":"] [get_bd_pins $RXTop_inst/axis_aclk]
  foreach name $axsio_names {
      set_property CONFIG.FREQ_HZ "${OP_CLK_FREQ}" [get_bd_intf_pins $RXTop_inst/$name]
  }
  set_property -dict [list CONFIG.FREQ_HZ "${OP_CLK_FREQ}" ] [get_bd_pins $RXTop_inst/axis_aclk]
  set_property -dict [list CONFIG.FREQ_HZ "${SYS_CLK_FREQ}" ] [get_bd_pins $RXTop_inst/axil_aclk]

  connect_bd_net [get_bd_pins $RXTop_inst/demux_type] [get_bd_pins $concat0/In0]
  connect_bd_net [get_bd_pins $RXTop_inst/debug_prob] [get_bd_pins $concat0/In1]


  lappend opclk_300_lst  [get_bd_pins $RXTop_inst/axis_aclk]
  lappend arst_300_lst   [get_bd_pins $RXTop_inst/axis_aresetn]
  lappend sysclk_100_lst [get_bd_pins $RXTop_inst/axil_aclk]
  lappend arst_100_lst   [get_bd_pins $RXTop_inst/axil_aresetn]

  # ==== TXTop Wrapper ====
