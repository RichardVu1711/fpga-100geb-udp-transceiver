  set block_cell_name TXTop_inst
  if { [catch {set TXTop_inst [create_bd_cell -type module -reference $block_name $block_cell_name] } errmsg] } {
    catch {common::send_gid_msg -ssname BD::TCL -id 2095 -severity "ERROR" "Unable to add referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
    return 1
  } elseif { $TXTop_inst eq "" } {
    catch {common::send_gid_msg -ssname BD::TCL -id 2096 -severity "ERROR" "Unable to referenced block <$block_name>. Please add the files for ${block_name}'s definition into the project."}
    return 1
  }
  set txsio_names {m00_axis s00_axis sarp_axis}
  set_property CONFIG.ASSOCIATED_BUSIF [join $txsio_names ":"] [get_bd_pins $TXTop_inst/axis_aclk]
  foreach name $txsio_names {
      set_property CONFIG.FREQ_HZ "${OP_CLK_FREQ}" [get_bd_intf_pins $TXTop_inst/$name]
  }
  set_property -dict [list CONFIG.FREQ_HZ "${OP_CLK_FREQ}" ] [get_bd_pins $TXTop_inst/axis_aclk]
  set_property -dict [list CONFIG.FREQ_HZ "${SYS_CLK_FREQ}" ] [get_bd_pins $TXTop_inst/axil_aclk]

  lappend opclk_300_lst  [get_bd_pins $TXTop_inst/axis_aclk]
  lappend arst_300_lst   [get_bd_pins $TXTop_inst/axis_aresetn]
  lappend sysclk_100_lst [get_bd_pins $TXTop_inst/axil_aclk]
  lappend arst_100_lst   [get_bd_pins $TXTop_inst/axil_aresetn]


  # ==== DEBUG ====
  set ila0 [ create_bd_cell -type ip -vlnv xilinx.com:ip:system_ila:1.1 ila0 ]
  set_property -dict [list \
    CONFIG.C_DATA_DEPTH {16384} \
    CONFIG.C_EN_STRG_QUAL {1} \
    CONFIG.C_MON_TYPE {MIX} \
    CONFIG.C_NUM_MONITOR_SLOTS {2} \
    CONFIG.C_NUM_OF_PROBES {7} \
    CONFIG.C_PROBE0_TYPE {0} \
    CONFIG.C_PROBE1_TYPE {0} \
    CONFIG.C_PROBE2_TYPE {0} \
    CONFIG.C_PROBE3_TYPE {0} \
    CONFIG.C_PROBE4_TYPE {0} \
    CONFIG.C_PROBE5_TYPE {0} \
    CONFIG.C_PROBE6_TYPE {0} \
    CONFIG.C_SLOT_0_APC_EN {0} \
    CONFIG.C_SLOT_0_AXI_DATA_SEL {1} \
    CONFIG.C_SLOT_0_AXI_TRIG_SEL {1} \
    CONFIG.C_SLOT_0_INTF_TYPE {xilinx.com:interface:axis_rtl:1.0} \
    CONFIG.C_SLOT_1_APC_EN {0} \
    CONFIG.C_SLOT_1_AXI_DATA_SEL {1} \
    CONFIG.C_SLOT_1_AXI_TRIG_SEL {1} \
    CONFIG.C_SLOT_1_INTF_TYPE {xilinx.com:interface:axis_rtl:1.0} \
  ] $ila0
  lappend rxclk_322_lst [get_bd_pins $ila0/clk]
  lappend arst_322_lst [get_bd_pins $ila0/resetn]

  set ila1 [ create_bd_cell -type ip -vlnv xilinx.com:ip:system_ila:1.1 ila1 ]
  set_property -dict [list \
    CONFIG.C_DATA_DEPTH {4096} \
    CONFIG.C_EN_STRG_QUAL {0} \
    CONFIG.C_INPUT_PIPE_STAGES {0} \
    CONFIG.C_MON_TYPE {MIX} \
    CONFIG.C_NUM_MONITOR_SLOTS {9} \
    CONFIG.C_NUM_OF_PROBES {1} \
    CONFIG.C_PROBE0_TYPE {0} \
    CONFIG.C_SLOT {0} \
    CONFIG.C_SLOT_0_APC_EN {0} \
    CONFIG.C_SLOT_0_AXI_DATA_SEL {1} \
    CONFIG.C_SLOT_0_AXI_TRIG_SEL {1} \
    CONFIG.C_SLOT_0_INTF_TYPE {xilinx.com:interface:axis_rtl:1.0} \
    CONFIG.C_SLOT_1_APC_EN {0} \
    CONFIG.C_SLOT_1_AXI_AR_SEL_DATA {1} \
    CONFIG.C_SLOT_1_AXI_AR_SEL_TRIG {1} \
    CONFIG.C_SLOT_1_AXI_AW_SEL_DATA {0} \
    CONFIG.C_SLOT_1_AXI_AW_SEL_TRIG {0} \
    CONFIG.C_SLOT_1_AXI_B_SEL_DATA {0} \
    CONFIG.C_SLOT_1_AXI_B_SEL_TRIG {0} \
    CONFIG.C_SLOT_1_AXI_R_SEL_DATA {1} \
    CONFIG.C_SLOT_1_AXI_R_SEL_TRIG {1} \
    CONFIG.C_SLOT_1_AXI_W_SEL_DATA {0} \
    CONFIG.C_SLOT_1_AXI_W_SEL_TRIG {0} \
    CONFIG.C_SLOT_1_INTF_TYPE {xilinx.com:interface:aximm_rtl:1.0} \
    CONFIG.C_SLOT_2_APC_EN {0} \
    CONFIG.C_SLOT_2_AXI_AR_SEL_DATA {0} \
    CONFIG.C_SLOT_2_AXI_AR_SEL_TRIG {0} \
    CONFIG.C_SLOT_2_AXI_AW_SEL_DATA {1} \
    CONFIG.C_SLOT_2_AXI_AW_SEL_TRIG {1} \
    CONFIG.C_SLOT_2_AXI_B_SEL_DATA {1} \
    CONFIG.C_SLOT_2_AXI_B_SEL_TRIG {1} \
    CONFIG.C_SLOT_2_AXI_R_SEL_DATA {0} \
    CONFIG.C_SLOT_2_AXI_R_SEL_TRIG {0} \
    CONFIG.C_SLOT_2_AXI_W_SEL_DATA {1} \
    CONFIG.C_SLOT_2_AXI_W_SEL_TRIG {1} \
    CONFIG.C_SLOT_2_INTF_TYPE {xilinx.com:interface:aximm_rtl:1.0} \
    CONFIG.C_SLOT_3_APC_EN {0} \
    CONFIG.C_SLOT_3_AXI_DATA_SEL {1} \
    CONFIG.C_SLOT_3_AXI_TRIG_SEL {1} \
    CONFIG.C_SLOT_3_INTF_TYPE {xilinx.com:interface:axis_rtl:1.0} \
    CONFIG.C_SLOT_4_APC_EN {0} \
    CONFIG.C_SLOT_4_AXI_DATA_SEL {1} \
    CONFIG.C_SLOT_4_AXI_TRIG_SEL {1} \
    CONFIG.C_SLOT_4_INTF_TYPE {xilinx.com:interface:axis_rtl:1.0} \
    CONFIG.C_SLOT_5_APC_EN {0} \
    CONFIG.C_SLOT_5_AXI_DATA_SEL {1} \
    CONFIG.C_SLOT_5_AXI_TRIG_SEL {1} \
    CONFIG.C_SLOT_5_INTF_TYPE {xilinx.com:interface:axis_rtl:1.0} \
    CONFIG.C_SLOT_6_APC_EN {0} \
    CONFIG.C_SLOT_6_AXI_DATA_SEL {1} \
    CONFIG.C_SLOT_6_AXI_TRIG_SEL {1} \
    CONFIG.C_SLOT_6_INTF_TYPE {xilinx.com:interface:axis_rtl:1.0} \
    CONFIG.C_SLOT_7_APC_EN {0} \
    CONFIG.C_SLOT_7_AXI_DATA_SEL {1} \
    CONFIG.C_SLOT_7_AXI_TRIG_SEL {1} \
    CONFIG.C_SLOT_7_INTF_TYPE {xilinx.com:interface:axis_rtl:1.0} \
    CONFIG.C_SLOT_8_APC_EN {0} \
    CONFIG.C_SLOT_8_AXI_DATA_SEL {1} \
    CONFIG.C_SLOT_8_AXI_TRIG_SEL {1} \
    CONFIG.C_SLOT_8_INTF_TYPE {xilinx.com:interface:axis_rtl:1.0} \
    CONFIG.C_TRIGIN_EN {false} \
  ] $ila1

  lappend opclk_300_lst [get_bd_pins $ila1/clk]
  lappend arst_300_lst  [get_bd_pins $ila1/resetn]

  set ila2 [ create_bd_cell -type ip -vlnv xilinx.com:ip:system_ila:1.1 ila2 ]
  set_property -dict [list \
    CONFIG.C_MON_TYPE {INTERFACE} \
    CONFIG.C_DATA_DEPTH {16384} \
    CONFIG.C_NUM_MONITOR_SLOTS {1} \
    CONFIG.C_SLOT_0_APC_EN {0} \
    CONFIG.C_SLOT_0_AXI_AR_SEL_DATA {1} \
    CONFIG.C_SLOT_0_AXI_AR_SEL_TRIG {1} \
    CONFIG.C_SLOT_0_AXI_AW_SEL_DATA {1} \
    CONFIG.C_SLOT_0_AXI_AW_SEL_TRIG {1} \
    CONFIG.C_SLOT_0_AXI_B_SEL_DATA {1} \
    CONFIG.C_SLOT_0_AXI_B_SEL_TRIG {1} \
    CONFIG.C_SLOT_0_AXI_R_SEL_DATA {1} \
    CONFIG.C_SLOT_0_AXI_R_SEL_TRIG {1} \
    CONFIG.C_SLOT_0_AXI_W_SEL_DATA {1} \
    CONFIG.C_SLOT_0_AXI_W_SEL_TRIG {1} \
    CONFIG.C_SLOT_0_INTF_TYPE {xilinx.com:interface:aximm_rtl:1.0} \
  ] $ila2
  lappend sysclk_100_lst [get_bd_pins $ila2/clk]
  lappend arst_100_lst   [get_bd_pins $ila2/resetn]



  # ==== Create reset procs ====
  set reset_list {
    rst_opclk_300MHz
    rst_sysclk_100MHz
    rst_cmacrx_322M
    rst_cmactx_322M
    rst_400MHz
    rst_200MHz
  }

  foreach entry $reset_list {
    set $entry [ create_bd_cell -type ip -vlnv xilinx.com:ip:proc_sys_reset:5.0 $entry ]
    # .... all in reset pins connected to pl resetn0
    connect_bd_net [get_bd_pins $zynqmp_ps/pl_resetn0] [get_bd_pins $entry/ext_reset_in]
  }
  
  lappend sysclk_100_lst [get_bd_pins $rst_sysclk_100MHz/slowest_sync_clk]
  lappend opclk_300_lst  [get_bd_pins $rst_opclk_300MHz/slowest_sync_clk]
  lappend rxclk_322_lst  [get_bd_pins $rst_cmacrx_322M/slowest_sync_clk]
  lappend txclk_322_lst  [get_bd_pins $rst_cmactx_322M/slowest_sync_clk]

  puts "INFO: WIRING RESET MODULES TO CLOCKS AND RESET SOURCES"
  wire_source_to_pins $rst_sysclk_100MHz/peripheral_aresetn $arst_100_lst
  wire_source_to_pins $rst_opclk_300MHz/peripheral_aresetn  $arst_300_lst
  wire_source_to_pins $rst_cmacrx_322M/peripheral_aresetn   $arst_322_lst
  wire_source_to_pins $rst_cmactx_322M/peripheral_aresetn   $arst_tx322_lst
  wire_source_to_pins $cmac/gt_rxusrclk2                    $rxclk_322_lst
  wire_source_to_pins $cmac/gt_txusrclk2                    $txclk_322_lst
  wire_source_to_pins $clk_wiz_0/sysclk                     $sysclk_100_lst
  wire_source_to_pins $clk_wiz_0/opclk                      $opclk_300_lst

  
  # ... connect peripheral_reset to all srst in cmac
  connect_bd_net [get_bd_pins $rst_sysclk_100MHz/peripheral_reset] \
                [get_bd_pins $cmac/sys_reset] \
                [get_bd_pins $cmac/s_axi_sreset]

  # ... connect backup clks (200 and 400 MHz) to the reset modules for future use
  connect_bd_net [get_bd_pins $clk_wiz_0/clk_out2] [get_bd_pins $rst_400MHz/slowest_sync_clk]
  connect_bd_net [get_bd_pins $clk_wiz_0/clk_out4] [get_bd_pins $rst_200MHz/slowest_sync_clk]
  

  # === DCM locked from clk_wiz_0 to reset modules ===
  foreach entry $reset_list {
    connect_bd_net [get_bd_pins $clk_wiz_0/locked] [get_bd_pins $entry/dcm_locked]
  }
  # ==== CONNECTIONS ====
  puts "INFO: CONNECTING AXI INTERFACES"
  connect_bd_intf_net [get_bd_intf_pins $dma/M_AXI_MM2S] [get_bd_intf_pins $axi_smc/S00_AXI]
  connect_bd_intf_net [get_bd_intf_pins $dma/M_AXI_S2MM] [get_bd_intf_pins $axi_smc/S01_AXI]
  connect_bd_intf_net [get_bd_intf_pins $axi_smc/M00_AXI] [get_bd_intf_pins $zynqmp_ps/S_AXI_HPC0_FPD]
  connect_bd_intf_net [get_bd_intf_pins $axi_smc/M01_AXI] [get_bd_intf_pins $zynqmp_ps/S_AXI_HPC1_FPD]
  connect_bd_intf_net [get_bd_intf_pins $zynqmp_ps/M_AXI_HPM0_FPD] [get_bd_intf_pins $ps_axi_periph/S00_AXI]
  connect_bd_intf_net [get_bd_intf_pins $zynqmp_ps/M_AXI_HPM1_FPD] [get_bd_intf_pins $ps_axi_periph/S01_AXI]

  # .... from cmac_rx to RX burst buffer to AXI Clock Converter to RXTop_inst
  wire_axis_to_axis $cmac/axis_rx                 $axis_data_fifo_rx/S_AXIS
  wire_axis_to_axis $axis_data_fifo_rx/M_AXIS     $axis_clk_converter_rx/S_AXIS
  wire_axis_to_axis $axis_clk_converter_rx/M_AXIS $RXTop_inst/s00_axis
  # .... RXTop stream out (m00_axis) to DMA
  wire_axis_to_axis $RXTop_inst/m00_axis           $dma/S_AXIS_S2MM
  # .... RXTop ARP stream out (marp_axis) to TXTop (sarp_axis)
  wire_axis_to_axis $RXTop_inst/marp_axis          $TXTop_inst/sarp_axis
  # .... DMA MM2S stream out to TXTop (s00_axis)
  wire_axis_to_axis $dma/M_AXIS_MM2S              $TXTop_inst/s00_axis
  # .... TXTop stream out (m00_axis) to AXI Clock Converter to CMAC TX
  wire_axis_to_axis $TXTop_inst/m00_axis          $axis_clk_converter_tx/S_AXIS
  wire_axis_to_axis $axis_clk_converter_tx/M_AXIS $cmac/axis_tx

  

  # .... Connect AXI-Lite interfaces from PS
  ## connect PS AXI-Lite to CMAC AXI-Lite
  connect_bd_intf_net [get_bd_intf_pins $ps_axi_periph/M00_AXI] [get_bd_intf_pins $cmac/s_axi]
  ## connect PS AXI-Lite to DMA AXI-Lite
  connect_bd_intf_net [get_bd_intf_pins $ps_axi_periph/M01_AXI] [get_bd_intf_pins $dma/S_AXI_LITE]
  ## connect PS AXI-Lite to RXTop AXI-Lite

  connect_bd_intf_net [get_bd_intf_pins $ps_axi_periph/M02_AXI] [get_bd_intf_pins $RXTop_inst/s_axil]
  ## connect PS AXI-Lite to TXTop AXI-Lite
  connect_bd_intf_net [get_bd_intf_pins $ps_axi_periph/M03_AXI] [get_bd_intf_pins $TXTop_inst/s_axil]
  # ==== Debugging ====
  puts "INFO: CONNECTING DEBUG PROBES"
  # .... debug probe0 connections (from CMAC RX)
  wire_buses_to_ila $cmac/stat_rx_aligned         $ila0/probe0
  wire_buses_to_ila $cmac/stat_rx_aligned_err     $ila0/probe1
  wire_buses_to_ila $cmac/stat_rx_bad_code        $ila0/probe2
  wire_buses_to_ila $cmac/stat_rx_bad_fcs         $ila0/probe3
  wire_buses_to_ila $cmac/stat_rx_framing_err_0   $ila0/probe4
  wire_buses_to_ila $cmac/stat_rx_status          $ila0/probe5
  wire_buses_to_ila $cmac/stat_rx_stomped_fcs     $ila0/probe6
  wire_axi_to_ila   $cmac/axis_rx                 $ila0/SLOT_0_AXIS
  # .... SLOT_0 above doubles as the RX burst buffer's input (same net as $cmac/axis_rx)
  wire_axi_to_ila   $axis_data_fifo_rx/M_AXIS      $ila0/SLOT_1_AXIS
  
  # .... debug probe1 connections (from AXI DMA)
  wire_axi_to_ila   $axis_clk_converter_rx/M_AXIS $ila1/SLOT_0_AXIS
  wire_axi_to_ila   $dma/M_AXI_MM2S               $ila1/SLOT_1_AXI
  wire_axi_to_ila   $dma/M_AXI_S2MM               $ila1/SLOT_2_AXI
  wire_axi_to_ila   $RXTop_inst/marp_axis          $ila1/SLOT_3_AXIS
  wire_axi_to_ila   $RXTop_inst/m00_axis           $ila1/SLOT_4_AXIS
  wire_axi_to_ila   $dma/M_AXIS_MM2S              $ila1/SLOT_5_AXIS
  wire_buses_to_ila $concat0/dout                 $ila1/probe0


  # Create address segments
  puts "INFO: CREATING ADDRESS SEGMENTS"
  assign_bd_address -offset 0xA0020000 -range 0x00010000 -target_address_space [get_bd_addr_spaces $zynqmp_ps/Data] [get_bd_addr_segs $RXTop_inst/s_axil/reg0] -force
  assign_bd_address -offset 0xA0030000 -range 0x00010000 -target_address_space [get_bd_addr_spaces $zynqmp_ps/Data] [get_bd_addr_segs $TXTop_inst/s_axil/reg0] -force
  assign_bd_address -offset 0xA0010000 -range 0x00010000 -target_address_space [get_bd_addr_spaces $zynqmp_ps/Data] [get_bd_addr_segs $dma/S_AXI_LITE/Reg] -force
  assign_bd_address -offset 0xA0000000 -range 0x00010000 -target_address_space [get_bd_addr_spaces $zynqmp_ps/Data] [get_bd_addr_segs $cmac/s_axi/Reg] -force
  assign_bd_address -offset 0x00000000 -range 0x80000000 -target_address_space [get_bd_addr_spaces $dma/Data_MM2S] [get_bd_addr_segs $zynqmp_ps/SAXIGP0/HPC0_DDR_LOW] -force
  assign_bd_address -offset 0x00000000 -range 0x40000000 -target_address_space [get_bd_addr_spaces $dma/Data_S2MM] [get_bd_addr_segs $zynqmp_ps/SAXIGP0/HPC0_DDR_LOW] -force
  assign_bd_address -offset 0x40000000 -range 0x40000000 -target_address_space [get_bd_addr_spaces $dma/Data_S2MM] [get_bd_addr_segs $zynqmp_ps/SAXIGP1/HPC1_DDR_LOW] -force
 
  # Exclude Address Segments
  puts "INFO: EXCLUDING ADDRESS SEGMENTS"
  exclude_bd_addr_seg -offset 0x000800000000 -range 0x000100000000 -target_address_space [get_bd_addr_spaces $dma/Data_MM2S] [get_bd_addr_segs $zynqmp_ps/SAXIGP0/HPC0_DDR_HIGH]
  exclude_bd_addr_seg -offset 0xFF000000 -range 0x01000000 -target_address_space [get_bd_addr_spaces $dma/Data_MM2S] [get_bd_addr_segs $zynqmp_ps/SAXIGP0/HPC0_LPS_OCM]
  exclude_bd_addr_seg -offset 0x000800000000 -range 0x000100000000 -target_address_space [get_bd_addr_spaces $dma/Data_MM2S] [get_bd_addr_segs $zynqmp_ps/SAXIGP1/HPC1_DDR_HIGH]
  exclude_bd_addr_seg -offset 0x00000000 -range 0x80000000 -target_address_space [get_bd_addr_spaces $dma/Data_MM2S] [get_bd_addr_segs $zynqmp_ps/SAXIGP1/HPC1_DDR_LOW]
  exclude_bd_addr_seg -offset 0xFF000000 -range 0x01000000 -target_address_space [get_bd_addr_spaces $dma/Data_MM2S] [get_bd_addr_segs $zynqmp_ps/SAXIGP1/HPC1_LPS_OCM]
  exclude_bd_addr_seg -offset 0x000800000000 -range 0x000100000000 -target_address_space [get_bd_addr_spaces $dma/Data_S2MM] [get_bd_addr_segs $zynqmp_ps/SAXIGP0/HPC0_DDR_HIGH]
  exclude_bd_addr_seg -offset 0xFF000000 -range 0x00800000 -target_address_space [get_bd_addr_spaces $dma/Data_S2MM] [get_bd_addr_segs $zynqmp_ps/SAXIGP0/HPC0_LPS_OCM]
  exclude_bd_addr_seg -offset 0x000800000000 -range 0x000100000000 -target_address_space [get_bd_addr_spaces $dma/Data_S2MM] [get_bd_addr_segs $zynqmp_ps/SAXIGP1/HPC1_DDR_HIGH]
  exclude_bd_addr_seg -offset 0xFF800000 -range 0x00800000 -target_address_space [get_bd_addr_spaces $dma/Data_S2MM] [get_bd_addr_segs $zynqmp_ps/SAXIGP1/HPC1_LPS_OCM]

  # Restore current instance
  current_bd_instance $oldCurInst

  # Create PFM attributes
  puts "INFO: CREATING PFM ATTRIBUTES"
  set_property PFM.CLOCK {sysclk {id "5" is_default "true" proc_sys_reset "/rst_sysclk_100MHz" status "fixed" freq_hz "100000000"} clk_out2 {id "6" is_default "false" proc_sys_reset "/rst_200MHz" status "fixed" freq_hz "200000000"} opclk {id "7" is_default "false" proc_sys_reset "/rst_opclk_300MHz" status "fixed" freq_hz "300000000"} clk_out4 {id "8" is_default "false" proc_sys_reset "/rst_400MHz" status "fixed" freq_hz "400000000"}} $clk_wiz_0
  set_property PFM.AXI_PORT {M_AXI_HPM0_LPD {memport "M_AXI_GP" sptag "" memory "" is_range "false"} S_AXI_HP0_FPD {memport "S_AXI_HP" sptag "" memory "" is_range "false"} S_AXI_HP1_FPD {memport "S_AXI_HP" sptag "" memory "" is_range "false"} S_AXI_HP2_FPD {memport "S_AXI_HP" sptag "" memory "" is_range "false"} S_AXI_HP3_FPD {memport "S_AXI_HP" sptag "" memory "" is_range "false"}} $zynqmp_ps
  set_property PFM.AXI_PORT {M02_AXI {memport "M_AXI_GP" sptag "" memory "" is_range "true"} M03_AXI {memport "M_AXI_GP" sptag "" memory "" is_range "true"} M04_AXI {memport "M_AXI_GP" sptag "" memory "" is_range "true"} M05_AXI {memport "M_AXI_GP" sptag "" memory "" is_range "true"} M06_AXI {memport "M_AXI_GP" sptag "" memory "" is_range "true"} M07_AXI {memport "M_AXI_GP" sptag "" memory "" is_range "true"}} $axi_smc

  validate_bd_design
  save_bd_design
  close_bd_design $design_name 
}

